# Переменные для scripts/deploy.sh (выставляются на VM при деплое по SSH,
# в GitHub Actions приходят из secrets/github.sha — см. cd.yml).
# Приложению (app/) сейчас никакие переменные окружения не требуются.

GHCR_IMAGE=ghcr.io/senku-kz/ci-cd-pipeline
ENV_NAME=master
IMAGE_TAG=master-latest
APP_PORT=8000
